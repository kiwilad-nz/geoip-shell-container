########################################
# GEOIP-SHELL DOCKER CONFIG
########################################

# ----------------------------
# Mode: whitelist | blacklist
# ----------------------------
MODE=whitelist

# ----------------------------
# Country codes (comma-separated)
# Example: NZ,AU,US
# ----------------------------
COUNTRIES=NZ,AU

# ----------------------------
# Direction: inbound | outbound
# ----------------------------
DIRECTION=inbound

# ----------------------------
# Port rules (space-separated)
# Format:
#   tcp:block:22
#   udp:allow:53
#   icmp:allow
# ----------------------------
PORT_RULES="tcp:block:22 tcp:block:443"

# ----------------------------
# Enable / disable geo blocking
# ----------------------------
GEOIP_STATE=on

# ----------------------------
# IP source provider
# ripe | ipdeny | maxmind | ipinfo
# ----------------------------
IP_SOURCE=ipdeny

# ----------------------------
# Firewall backend override
# nft = nftables (recommended)
# ipt = iptables
# leave empty = auto (default nftables if available)
# ----------------------------
FIREWALL_BACKEND=nft

# ----------------------------
# Cron schedule (optional)
# Example: run updates daily at 3AM
# ----------------------------
SCHEDULE=0 3 * * *

# ----------------------------
# Timezone
# ----------------------------
TZ=Pacific/Auckland

# ----------------------------
# Reset config on container start
# true = wipes previous config each start
# false = persistent config
# ----------------------------
RESET=false

# ----------------------------
# Show status after startup
# ----------------------------
SHOW_STATUS=true

# ----------------------------
# Optional log file (inside container volume)
# ----------------------------
LOG_FILE=/logs/geoip-shell.log
